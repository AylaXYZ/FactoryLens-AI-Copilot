# Generation: demo requires no key; openai uses an OpenAI-compatible API; ollama is local.
LLM_PROVIDER=demo
# Embeddings: demo uses local hashing; openai/ollama/bge provide real semantic retrieval.
EMBEDDING_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=bge-m3
BGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
TOP_K=4
DATA_DIR=.factorylens
